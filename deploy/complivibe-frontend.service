[Unit]
Description=CompliVibe Frontend (Next.js)
After=network.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/complivibe-frontend-v3.0-phase-a
EnvironmentFile=-/home/ubuntu/complivibe-frontend-v3.0-phase-a/.env.local
# scripts/deploy.sh writes the deployed commit's SHA/build time into this
# file immediately before each restart -- do not hardcode them here.
EnvironmentFile=-/home/ubuntu/complivibe-frontend-v3.0-phase-a/deploy/current-version.env
ExecStart=/usr/bin/npm start -- -p 3000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
